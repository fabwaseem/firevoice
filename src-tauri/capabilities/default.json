{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: file dialogs, saving renders, opening links, persisted settings and the managed backend.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-set-theme",
    "shell:allow-open",
    "dialog:default",
    "fs:default",
    "fs:allow-write-file",
    "fs:allow-read-file",
    {
      "identifier": "fs:scope",
      "allow": [
        "$DOWNLOAD/**",
        "$DOCUMENT/**",
        "$DESKTOP/**",
        "$AUDIO/**",
        "$VIDEO/**",
        "$TEMP/**",
        "$APPLOCALDATA/**",
        "$APPLOG/**"
      ]
    },
    "opener:default",
    "store:default"
  ]
}
