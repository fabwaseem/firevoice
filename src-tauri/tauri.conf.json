{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FireVoice",
  "version": "1.4.0",
  "identifier": "dev.firestack.firevoice",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node scripts/dev-ui.mjs",
    "beforeBuildCommand": "node scripts/bundle-backend.mjs && pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FireVoice",
        "width": 1380,
        "height": 880,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#f3f4f8"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: http: https:",
        "media-src": "'self' data: blob: http: https:",
        "connect-src": "'self' ipc: http://ipc.localhost http: https: ws: wss:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Local expressive text-to-speech and speech-to-text studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": {
      "resources/backend/": "backend/"
    }
  },
  "plugins": {}
}
